model AutomacaoExecucao {
  id                Int                      @id @default(autoincrement())
  empresaId         Int
  empresa           Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  regraId           Int
  regra             AutomacaoRegra           @relation(fields: [empresaId, regraId], references: [empresaId, id], onDelete: Cascade, onUpdate: Restrict)
  regraVersao       Int
  regraSnapshotJson String
  entidadeTipo      EntidadeAutomacao
  entidadeId        Int
  leadId            Int?
  lead              Lead?                    @relation(fields: [empresaId, leadId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  negocioId         Int?
  negocio           Negocio?                 @relation(fields: [empresaId, negocioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  occurrenceKey     String
  idempotencyKey    String
  status            StatusExecucaoAutomacao  @default(PENDENTE)
  tentativas        Int                      @default(0)
  iniciadaEm        DateTime?
  concluidaEm       DateTime?
  erroCodigo        String?
  erroResumo        String?
  resumoJson        String?
