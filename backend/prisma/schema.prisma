  avaliacoesRegraEstoque AvaliacaoRegraEstoque[]

  @@unique([empresaId, id])
  @@index([empresaId, produtoEstoqueId, estado])
  @@index([empresaId, fonteId, sourceLotId])
  @@index([empresaId, fonteId, codigoLote])
  @@index([empresaId, validadeEm])
