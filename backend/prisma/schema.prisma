  versoes                  PropostaComercial[]          @relation("VersoesPropostaComercial")
  codigo                   String
  titulo                   String
  descricao                String?
  descontoGeralCentavos    Int                         @default(0)
  subtotalCentavos         Int                         @default(0)
  totalCentavos            Int                         @default(0)
  validade                 DateTime
  observacoes              String?
  condicoesComerciais      String?
