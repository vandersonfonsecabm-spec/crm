  retentionUntil     DateTime
  empresa            Empresa               @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fonte              FonteEstoque          @relation(fields: [empresaId, fonteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  syncRun            ExecucaoSincronizacaoEstoque  @relation(fields: [empresaId, syncRunId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([empresaId, fonteId, sourceEntityType, sourceRecordId, sourceVersion])
  @@index([empresaId, fonteId, checksum])
  @@index([empresaId, retentionUntil])
}

model ProblemaQualidadeEstoque {
  id                     Int                     @id @default(autoincrement())
  empresaId              Int
  fonteId                Int
  // Source-level quality may exist before a specific synchronization run.
  syncRunId              Int?
  tipo                   String
  severidade             String
  targetRef              String?
  estado                 StockQualityState       @default(OPEN)
  firstSeenAt            DateTime                @default(now())
  lastSeenAt             DateTime                @default(now())
  resolvedAt             DateTime?
  detailsSanitizedJson   String?
  retentionUntil         DateTime
  revision               Int                     @default(1)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  empresa                Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fonte                  FonteEstoque            @relation(fields: [empresaId, fonteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  syncRun                ExecucaoSincronizacaoEstoque? @relation(fields: [empresaId, syncRunId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([empresaId, estado, lastSeenAt])
  @@index([empresaId, fonteId, tipo])
  @@index([empresaId, retentionUntil])
}

model EventoAuditoriaEstoque {
  id                    Int                 @id @default(autoincrement())
  empresaId             Int
  actorType             StockAuditActorType
  actorUsuarioId        Int?
  actorSystemKey        String?
  action                String
  beforeJsonSanitized   String?
  afterJsonSanitized    String?
  correlationId         String?
  createdAt             DateTime            @default(now())
  empresa               Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorUsuario          Usuario?            @relation("EventoAuditoriaEstoqueActor", fields: [empresaId, actorUsuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([empresaId, action, createdAt])
  @@index([empresaId, actorUsuarioId, createdAt])
}

model EventoOutboxEstoque {
  id                    Int                @id @default(autoincrement())
  empresaId             Int
  eventType             String
  aggregateType         String
  aggregateId           String
  materialVersion       Int
  payloadStructuredJson String?
  status                StockOutboxStatus  @default(PENDING)
  attempts              Int                @default(0)
  availableAt           DateTime           @default(now())
  leaseOwner            String?
  leaseExpiresAt        DateTime?
  processedAt           DateTime?
  correlationId         String?
  retentionUntil        DateTime
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  empresa               Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([empresaId, eventType, aggregateType, aggregateId, materialVersion])
  @@index([empresaId, status, availableAt])
  @@index([empresaId, leaseExpiresAt])
  @@index([empresaId, retentionUntil])
}

model ImportacaoEstoque {
  id              Int                @id @default(autoincrement())
  empresaId       Int
  fonteId         Int
  actorUsuarioId  Int
  status          StockImportStatus  @default(PREVIEW)
  schemaVersion   String
  fileHash        String
  safeFilename    String
  byteSize        Int
  rowCount        Int                @default(0)
  acceptedCount   Int                @default(0)
  rejectedCount   Int                @default(0)
  idempotencyKey  String
  correlationId   String?
  revision        Int                @default(1)
  expiresAt       DateTime
  retentionUntil  DateTime
  syncRunId       Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  empresa         Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fonte           FonteEstoque       @relation(fields: [empresaId, fonteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  actorUsuario    Usuario            @relation("ImportacaoEstoqueActor", fields: [empresaId, actorUsuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  syncRun         ExecucaoSincronizacaoEstoque? @relation(fields: [empresaId, syncRunId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  linhas          LinhaImportacaoEstoque[]

  @@unique([empresaId, id])
  @@unique([empresaId, idempotencyKey])
  @@index([empresaId, fonteId, fileHash, schemaVersion])
  @@index([empresaId, status, expiresAt])
  @@index([empresaId, actorUsuarioId, createdAt])
  @@index([empresaId, retentionUntil])
}

model LinhaImportacaoEstoque {
  id                       Int                   @id @default(autoincrement())
  empresaId                Int
  importacaoId             Int
  rowNumber                Int
  rowChecksum              String
  sourceRecordId           String
  sourceVersion            String?
  status                   StockImportRowStatus  @default(PENDING)
  normalizedJsonSanitized  String?
  warningsJson             String?
  errorsJson               String?
  appliedAt                DateTime?
  retentionUntil           DateTime
  revision                 Int                   @default(1)
  empresa                  Empresa               @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  importacao               ImportacaoEstoque     @relation(fields: [empresaId, importacaoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([empresaId, importacaoId, rowNumber])
  @@index([empresaId, importacaoId, rowChecksum])
  @@index([empresaId, retentionUntil])
}

// E3 rule configuration/evidence. Evaluation reads only committed canonical
// state; source payloads are never accepted as rule input.
model ConfiguracaoRegraEstoque {
  id                       Int      @id @default(autoincrement())
  empresaId                Int
  ruleType                 String
  scopeType                String   @default("TENANT")
  scopeKey                 String   @default("TENANT")
  enabled                  Boolean  @default(false)
  expiryWindowDays         Int?
  freshnessSlaMinutes      Int?
  timezone                 String?
  requiredCapabilitiesJson String?
  priorityBandsJson       String?
  recipientPolicyJson     String?
  suppressionPolicyJson   String?
  revision                 Int      @default(1)
  actorRef                 String?
  correlationId            String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  empresa                  Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([empresaId, ruleType, scopeType, scopeKey])
  @@unique([empresaId, id])
  @@index([empresaId, ruleType, enabled])
  @@index([empresaId, updatedAt])
}

model OverrideEstoque {
  id                       Int      @id @default(autoincrement())
  empresaId                Int
  ruleType                 String
  targetType               String
  targetId                 String
  enabled                  Boolean?
  thresholdJson            String?
  freshnessSlaMinutes     Int?
  priority                 String?
  recipientPolicyJson     String?
  revision                 Int      @default(1)
  actorRef                 String?
  correlationId            String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  empresa                  Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([empresaId, ruleType, targetType, targetId])
  @@unique([empresaId, id])
  @@index([empresaId, ruleType, targetType, targetId])
  @@index([empresaId, updatedAt])
}

model AvaliacaoRegraEstoque {
  id                       Int       @id @default(autoincrement())
  empresaId                Int
  schemaVersion             String
  ruleType                 String
  sourceConnectionId       Int?
  scopeJson                String?
  produtoEstoqueId        Int?
  loteEstoqueId           Int?
  localEstoqueId          Int?
  requiredCapabilitiesJson String?
  capabilitiesObservedJson String?
  enabledEffective         Boolean
  thresholdJson            String?
  evaluationTime           DateTime
  tenantTimezone           String
  freshnessRequirement     String?
  freshnessObserved        String?
  quantitySemantic         String?
  quantityRelevant         Boolean?
  expiryDate               String?
  expiryPrecision          String?
  matched                  Boolean
  noMatchReason            String?
  priority                 String?
  occurrenceKey            String
  materialVersion          Int
  materialChange           Boolean       @default(false)
  destinationJson          String?
  resolutionCandidate      String?
  suppressionPolicyJson    String?
  confidence               String?
  correlationId            String?
  evaluatedAt              DateTime      @default(now())
  retentionUntil           DateTime
  empresa                  Empresa       @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  produtoEstoque           ProdutoEstoque? @relation(fields: [empresaId, produtoEstoqueId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  loteEstoque              LoteEstoque?  @relation(fields: [empresaId, loteEstoqueId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  localEstoque             LocalEstoque? @relation(fields: [empresaId, localEstoqueId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  fonte                    FonteEstoque? @relation("AvaliacaoRegraEstoqueFonte", fields: [empresaId, sourceConnectionId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([empresaId, id])
  @@index([empresaId, ruleType, evaluatedAt])
  @@index([empresaId, occurrenceKey, materialVersion])
  @@index([empresaId, matched, evaluatedAt])
  @@index([empresaId, retentionUntil])
}

