  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// E2 estoque source-agnostic. Todas as relacoes entre entidades tenant-scoped
// usam [empresaId, id] para impedir vinculos cruzados entre tenants.
model FonteEstoque {
  id                       Int                       @id @default(autoincrement())
  empresaId                Int
  tipoFonte                StockSourceType
  nome                     String
  statusCiclo              StockSourceStatus         @default(DRAFT)
  configuracaoPublicaJson  String?
  credencialRef            String?
  capabilitiesVersion      String?
  prioridade               Int                       @default(100)
  schemaVersion            String
  disabledAt               DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  empresa                  Empresa                   @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  capacidades              CapacidadeFonteEstoque[]
  execucoes                ExecucaoSincronizacaoEstoque[]
  checkpoint               CheckpointSincronizacaoEstoque?
  mapeamentos              MapeamentoProdutoExterno[]
  locais                   LocalEstoque[]
  lotes                    LoteEstoque[]
  saldosAutoritativos      SaldoEstoque[]            @relation("SaldoEstoqueFonteAutoritativa")
  observacoes              ObservacaoEstoque[]
  problemasQualidade       ProblemaQualidadeEstoque[]
  importacoes              ImportacaoEstoque[]

  @@unique([empresaId, nome])
  @@unique([empresaId, id])
  @@index([empresaId, statusCiclo])
  @@index([empresaId, tipoFonte, statusCiclo])
}

model CapacidadeFonteEstoque {
  id             Int          @id @default(autoincrement())
  empresaId      Int
  fonteId        Int
  codigo         String
  suportada      Boolean      @default(false)
  semanticaJson  String?
  versao         String
  observadaEm    DateTime     @default(now())
  empresa        Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fonte          FonteEstoque @relation(fields: [empresaId, fonteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([empresaId, fonteId, codigo, versao])
  @@index([empresaId, fonteId, suportada])
}

model ExecucaoSincronizacaoEstoque {
  id                Int             @id @default(autoincrement())
  empresaId         Int
  fonteId           Int
  modo              StockSyncMode
  estado            StockSyncStatus @default(PENDING)
  startedAt         DateTime        @default(now())
  finishedAt        DateTime?
  cursorAntes       String?
  cursorDepois      String?
  snapshotGeneration String?
  lidos             Int             @default(0)
  aceitos           Int             @default(0)
  rejeitados        Int             @default(0)
  criados           Int             @default(0)
  atualizados       Int             @default(0)
  tombstoned        Int             @default(0)
  warningsJson      String?
  errorClass        String?
  retryCount        Int             @default(0)
  correlationId     String?
  leaseOwner        String?
  leaseExpiresAt    DateTime?
  revision          Int             @default(1)
  retentionUntil    DateTime
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  empresa           Empresa         @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fonte             FonteEstoque    @relation(fields: [empresaId, fonteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  observacoes       ObservacaoEstoque[]
  problemasQualidade ProblemaQualidadeEstoque[]
  importacoes       ImportacaoEstoque[]

  @@unique([empresaId, id])
  @@index([empresaId, fonteId, startedAt])
  @@index([empresaId, estado, leaseExpiresAt])
  @@index([empresaId, retentionUntil])
}

model CheckpointSincronizacaoEstoque {
  id                     Int          @id @default(autoincrement())
  empresaId              Int
  fonteId                Int
  cursor                 String?
  sourceGeneration       String?
  lastSuccessfulSyncAt   DateTime?
  lastFullSnapshotAt     DateTime?
  lastIncrementalSyncAt  DateTime?
  revision               Int          @default(1)
  updatedAt              DateTime     @updatedAt
  empresa                Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fonte                  FonteEstoque @relation(fields: [empresaId, fonteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([empresaId, fonteId])
  @@unique([empresaId, id])
}

model ProdutoEstoque {
  id                       Int                       @id @default(autoincrement())
  empresaId                Int
  nomeExibicao             String
  skuCanonico              String?
  skuCanonicoConfirmado    Boolean                   @default(false)
  barcodeCanonico          String?
  barcodeCanonicoConfirmado Boolean                  @default(false)
  unidadeCanonica          String
  ativo                    Boolean                   @default(true)
  metadataNamespacedJson   String?
  revision                 Int                       @default(1)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  empresa                  Empresa                   @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mapeamentosExternos      MapeamentoProdutoExterno[]
  lotes                    LoteEstoque[]
  saldos                   SaldoEstoque[]

  @@unique([empresaId, id])
  @@index([empresaId, skuCanonico])
  @@index([empresaId, barcodeCanonico])
  @@index([empresaId, ativo])
}

model MapeamentoProdutoExterno {
  id                Int                @id @default(autoincrement())
  empresaId         Int
  fonteId           Int
  sourceProductId   String
  produtoEstoqueId  Int?
  estado            StockMappingStatus @default(UNMATCHED)
  evidenciaJson     String?
  sourceVersion     String
  revision          Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  empresa           Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fonte             FonteEstoque       @relation(fields: [empresaId, fonteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  produtoEstoque    ProdutoEstoque?    @relation(fields: [empresaId, produtoEstoqueId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([empresaId, fonteId, sourceProductId])
  @@index([empresaId, produtoEstoqueId, estado])
}

model LocalEstoque {
  id                 Int              @id @default(autoincrement())
  empresaId          Int
  fonteId            Int?
  externalLocationId String?
  nome               String
  tipo               StockLocationType @default(UNKNOWN)
  parentId           Int?
  ativo              Boolean          @default(true)
  revision           Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  empresa            Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fonte              FonteEstoque?    @relation(fields: [empresaId, fonteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  pai                LocalEstoque?    @relation("LocalEstoqueHierarquia", fields: [empresaId, parentId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  filhos             LocalEstoque[]   @relation("LocalEstoqueHierarquia")
  saldos             SaldoEstoque[]

  @@unique([empresaId, id])
  @@index([empresaId, fonteId, externalLocationId])
  @@index([empresaId, parentId])
}

model LoteEstoque {
  id                 Int                     @id @default(autoincrement())
  empresaId          Int
  produtoEstoqueId   Int
  fonteId            Int
  sourceLotId        String?
  codigoLote         String?
  // ISO day strings are portable across SQLite/PostgreSQL. The precision
  // enum tells whether the value is YYYY-MM-DD, YYYY-MM, YYYY or unknown.
  validadeEm         String?
  precisaoValidade   StockLotExpiryPrecision @default(UNKNOWN)
  estado             StockLotStatus          @default(UNKNOWN)
  sourceUpdatedAt    DateTime?
  observedAt         DateTime                @default(now())
  revision           Int                     @default(1)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  empresa            Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  produtoEstoque     ProdutoEstoque          @relation(fields: [empresaId, produtoEstoqueId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  fonte              FonteEstoque            @relation(fields: [empresaId, fonteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  saldos             SaldoEstoque[]

  @@unique([empresaId, id])
  @@index([empresaId, produtoEstoqueId, estado])
  @@index([empresaId, fonteId, sourceLotId])
  @@index([empresaId, fonteId, codigoLote])
  @@index([empresaId, validadeEm])
}

model SaldoEstoque {
  id                        Int                     @id @default(autoincrement())
  empresaId                 Int
  produtoEstoqueId          Int
  loteId                    Int?
  localId                   Int?
  fonteAutoritativaId       Int
  unidade                   String
  onHand                    Decimal                 @default(0)
  reserved                  Decimal?
  available                 Decimal?
  quarantined               Decimal?
  damaged                   Decimal?
  inTransit                 Decimal?
  semanticaDisponivel       StockAvailableSemantics @default(UNKNOWN)
  quantityRelevantForExpiry Boolean                 @default(false)
  sourceUpdatedAt           DateTime?
  observedAt                DateTime                @default(now())
  freshnessEstado           StockFreshnessState     @default(UNKNOWN)
  dataConfidence            StockDataConfidence     @default(UNKNOWN)
  sourceVersion             String
  revision                  Int                     @default(1)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  empresa                   Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  produtoEstoque            ProdutoEstoque          @relation(fields: [empresaId, produtoEstoqueId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  lote                      LoteEstoque?            @relation(fields: [empresaId, loteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  local                     LocalEstoque?           @relation(fields: [empresaId, localId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  fonteAutoritativa         FonteEstoque            @relation("SaldoEstoqueFonteAutoritativa", fields: [empresaId, fonteAutoritativaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([empresaId, produtoEstoqueId])
  @@index([empresaId, loteId])
  @@index([empresaId, localId])
  @@index([empresaId, fonteAutoritativaId])
  @@index([empresaId, freshnessEstado, observedAt])
}

model ObservacaoEstoque {
  id                 Int                   @id @default(autoincrement())
  empresaId          Int
  fonteId            Int
  syncRunId          Int
  sourceEntityType   String
  sourceRecordId     String
  sourceVersion      String
  checksum           String
  observedAt         DateTime              @default(now())
  dataQuality        StockDataConfidence  @default(UNKNOWN)
  warningsJson       String?
  appliedAt          DateTime?
  retentionUntil     DateTime
  empresa            Empresa               @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fonte              FonteEstoque          @relation(fields: [empresaId, fonteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  syncRun            ExecucaoSincronizacaoEstoque  @relation(fields: [empresaId, syncRunId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([empresaId, fonteId, sourceEntityType, sourceRecordId, sourceVersion])
  @@index([empresaId, fonteId, checksum])
  @@index([empresaId, retentionUntil])
}

model ProblemaQualidadeEstoque {
  id                     Int                     @id @default(autoincrement())
  empresaId              Int
  fonteId                Int
  // Source-level quality may exist before a specific synchronization run.
  syncRunId              Int?
  tipo                   String
  severidade             String
  targetRef              String?
  estado                 StockQualityState       @default(OPEN)
  firstSeenAt            DateTime                @default(now())
  lastSeenAt             DateTime                @default(now())
  resolvedAt             DateTime?
  detailsSanitizedJson   String?
  retentionUntil         DateTime
  revision               Int                     @default(1)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  empresa                Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fonte                  FonteEstoque            @relation(fields: [empresaId, fonteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  syncRun                ExecucaoSincronizacaoEstoque? @relation(fields: [empresaId, syncRunId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([empresaId, estado, lastSeenAt])
  @@index([empresaId, fonteId, tipo])
  @@index([empresaId, retentionUntil])
}

model EventoAuditoriaEstoque {
  id                    Int                 @id @default(autoincrement())
  empresaId             Int
  actorType             StockAuditActorType
  actorUsuarioId        Int?
  actorSystemKey        String?
  action                String
  beforeJsonSanitized   String?
  afterJsonSanitized    String?
  correlationId         String?
  createdAt             DateTime            @default(now())
  empresa               Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorUsuario          Usuario?            @relation("EventoAuditoriaEstoqueActor", fields: [empresaId, actorUsuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([empresaId, action, createdAt])
  @@index([empresaId, actorUsuarioId, createdAt])
}

model EventoOutboxEstoque {
  id                    Int                @id @default(autoincrement())
  empresaId             Int
  eventType             String
  aggregateType         String
  aggregateId           String
  materialVersion       Int
  payloadStructuredJson String?
  status                StockOutboxStatus  @default(PENDING)
  attempts              Int                @default(0)
  availableAt           DateTime           @default(now())
  leaseOwner            String?
  leaseExpiresAt        DateTime?
  processedAt           DateTime?
  correlationId         String?
  retentionUntil        DateTime
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  empresa               Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([empresaId, eventType, aggregateType, aggregateId, materialVersion])
  @@index([empresaId, status, availableAt])
  @@index([empresaId, leaseExpiresAt])
  @@index([empresaId, retentionUntil])
}

model ImportacaoEstoque {
  id              Int                @id @default(autoincrement())
  empresaId       Int
  fonteId         Int
  actorUsuarioId  Int
  status          StockImportStatus  @default(PREVIEW)
  schemaVersion   String
  fileHash        String
  safeFilename    String
  byteSize        Int
  rowCount        Int                @default(0)
  acceptedCount   Int                @default(0)
  rejectedCount   Int                @default(0)
  idempotencyKey  String
  correlationId   String?
  revision        Int                @default(1)
  expiresAt       DateTime
  retentionUntil  DateTime
  syncRunId       Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  empresa         Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fonte           FonteEstoque       @relation(fields: [empresaId, fonteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  actorUsuario    Usuario            @relation("ImportacaoEstoqueActor", fields: [empresaId, actorUsuarioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  syncRun         ExecucaoSincronizacaoEstoque? @relation(fields: [empresaId, syncRunId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  linhas          LinhaImportacaoEstoque[]

  @@unique([empresaId, id])
  @@unique([empresaId, idempotencyKey])
  @@index([empresaId, fonteId, fileHash, schemaVersion])
  @@index([empresaId, status, expiresAt])
  @@index([empresaId, actorUsuarioId, createdAt])
  @@index([empresaId, retentionUntil])
}

model LinhaImportacaoEstoque {
  id                       Int                   @id @default(autoincrement())
  empresaId                Int
  importacaoId             Int
  rowNumber                Int
  rowChecksum              String
  sourceRecordId           String
  sourceVersion            String?
  status                   StockImportRowStatus  @default(PENDING)
  normalizedJsonSanitized  String?
  warningsJson             String?
  errorsJson               String?
  appliedAt                DateTime?
  retentionUntil           DateTime
  revision                 Int                   @default(1)
  empresa                  Empresa               @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  importacao               ImportacaoEstoque     @relation(fields: [empresaId, importacaoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([empresaId, importacaoId, rowNumber])
  @@index([empresaId, importacaoId, rowChecksum])
  @@index([empresaId, retentionUntil])
}

