generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Cliente {
  id              Int              @id @default(autoincrement())
  empresaId       Int
  empresaTenant   Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  nome            String
  telefone        String           @default("")
  email           String           @default("")
  empresa         String           @default("")
  cidade          String?
  estado          String?
  cpfCnpj         String?
  interesse       String           @default("")
  status          String           @default("Lead")
  arquivadoEm     DateTime?
  statusAntesDeArquivar String?
  valor           Int              @default(0)
  origem          String           @default("Manual")
  favorito        Boolean          @default(false)
  quente          Boolean          @default(false)
  ultimoContato   Int              @default(0)
  proximoFollowUp String           @default("Hoje")
  tags            String           @default("[]")
  revisao         Int              @default(1)
  createdAt       DateTime         @default(now())
  notas           Nota[]
  acompanhamentos Acompanhamento[]
  leads           Lead[]
  negocios        Negocio[]        @relation("NegocioCliente")
  negociosLegados Negocio[]        @relation("NegocioClienteLegado")
  contatosCanal   ContatoCanal[]
  historicosQualificacao HistoricoQualificacaoConversa[]
  ofertasProduto       ProductOffer[] @relation("ProductOfferCustomer")
  interessesAICommerce AICommerceProductInterest[] @relation("AICommerceInterestCustomer")
  rascunhosAICommerce AICommerceOpportunityDraft[] @relation("AICommerceDraftCustomer")
  propostasComerciais PropostaComercial[]

  @@unique([empresaId, id])
  @@index([empresaId])
  @@index([empresaId, status])
  @@index([empresaId, quente])
  @@index([empresaId, createdAt])
  @@index([empresaId, arquivadoEm])
}

model Nota {
  id        Int      @id @default(autoincrement())
  empresaId Int
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  texto     String
  tipo      String   @default("nota")
  createdAt DateTime @default(now())
  clienteId Int
  cliente   Cliente  @relation(fields: [empresaId, clienteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([empresaId])
  @@index([clienteId])
  @@index([empresaId, clienteId])
  @@index([empresaId, createdAt])
}

model CategoriaProduto {
  id        Int       @id @default(autoincrement())
  nome      String    @unique
  descricao String?
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  produtos  Produto[]
}

model Produto {
  id                 Int                   @id @default(autoincrement())
  nome               String
  codigo             String?               @unique
  descricao          String?
  categoriaId        Int?
  categoria          CategoriaProduto?     @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  unidadeMedida      String                @default("UN")
  quantidadeAtual    Decimal               @default(0)
  estoqueMinimo      Decimal               @default(0)
  precoCustoCentavos Int                   @default(0)
  precoVendaCentavos Int                   @default(0)
  ativo              Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  movimentacoes      MovimentacaoEstoque[]

  @@index([categoriaId])
  @@index([ativo])
}

model MovimentacaoEstoque {
  id                  Int                     @id @default(autoincrement())
  produtoId           Int
  produto             Produto                 @relation(fields: [produtoId], references: [id])
  tipo                TipoMovimentacaoEstoque
  quantidade          Decimal
  quantidadeAnterior  Decimal
  quantidadePosterior Decimal
  motivo              String?
  observacao          String?
  createdAt           DateTime                @default(now())

  @@index([produtoId])
  @@index([tipo])
  @@index([createdAt])
}

model Acompanhamento {
  id              Int                      @id @default(autoincrement())
  empresaId       Int
  empresa         Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  clienteId       Int?
  cliente         Cliente?                 @relation(fields: [empresaId, clienteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  leadId          Int?
  lead            Lead?                    @relation(fields: [empresaId, leadId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  conversaCanalId Int?
  conversaCanal   ConversaCanal?           @relation(fields: [empresaId, conversaCanalId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  negocioId       Int?
  negocio         Negocio?                 @relation(fields: [empresaId, negocioId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  propostaComercialId Int?
  propostaComercial   PropostaComercial?   @relation(fields: [empresaId, propostaComercialId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  responsavelId   Int?
  responsavelUsuario Usuario?               @relation("AcompanhamentoResponsavel", fields: [empresaId, responsavelId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  autorId         Int?
  autor            Usuario?                 @relation("AcompanhamentoAutor", fields: [empresaId, autorId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  concluidoPorId  Int?
  concluidoPor    Usuario?                  @relation("AcompanhamentoConcluidoPor", fields: [empresaId, concluidoPorId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  canceladoPorId  Int?
  canceladoPor    Usuario?                  @relation("AcompanhamentoCanceladoPor", fields: [empresaId, canceladoPorId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  titulo          String
  descricao       String?
  dataHora        DateTime
  prioridade      PrioridadeAcompanhamento @default(MEDIA)
  status          StatusAcompanhamento     @default(PENDENTE)
  tipo            TipoAcompanhamento       @default(LIGACAO)
  responsavel     String?
  concluidoEm     DateTime?
  canceladoEm     DateTime?
  revisao         Int                      @default(1)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  historico       HistoricoAcompanhamento[]
  automacaoEventosInternos AutomacaoEventoInterno[]
  notificacaoAntecedenciaMinutos Int?

  @@unique([empresaId, id])
  @@index([empresaId])
  @@index([clienteId])
  @@index([empresaId, clienteId])
  @@index([empresaId, dataHora])
  @@index([empresaId, status])
  @@index([empresaId, prioridade])
  @@index([empresaId, tipo])
  @@index([empresaId, leadId])
  @@index([empresaId, conversaCanalId])
  @@index([empresaId, negocioId])
  @@index([empresaId, propostaComercialId])
  @@index([empresaId, responsavelId, status])
  @@index([empresaId, autorId, createdAt])
}

model HistoricoAcompanhamento {
  id                       Int                        @id @default(autoincrement())
  empresaId                Int
  empresa                  Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  acompanhamentoId         Int
  acompanhamento           Acompanhamento             @relation(fields: [empresaId, acompanhamentoId], references: [empresaId, id], onDelete: Cascade, onUpdate: Restrict)
  autorId                  Int
  autor                    Usuario                     @relation("HistoricoAcompanhamentoAutor", fields: [empresaId, autorId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  acao                     TipoAcaoAcompanhamento
  statusAnterior           StatusAcompanhamento?
  statusNovo               StatusAcompanhamento?
  responsavelAnteriorId    Int?
  responsavelAnterior      Usuario?                    @relation("HistoricoAcompanhamentoResponsavelAnterior", fields: [empresaId, responsavelAnteriorId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  responsavelNovoId        Int?
  responsavelNovo          Usuario?                    @relation("HistoricoAcompanhamentoResponsavelNovo", fields: [empresaId, responsavelNovoId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  dataHoraAnterior         DateTime?
  dataHoraNova             DateTime?
  observacao               String?
  createdAt                DateTime                    @default(now())

  @@index([empresaId, acompanhamentoId, createdAt])
  @@index([empresaId, autorId, createdAt])
}

model Empresa {
  id                         Int                        @id @default(autoincrement())
  nome                       String
  slug                       String                     @unique
  ativo                      Boolean                    @default(true)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  usuarios                   Usuario[]
  clientes                   Cliente[]
  notas                      Nota[]
  acompanhamentos            Acompanhamento[]
  integracoes                Integracao[]
  sincronizacoesIntegracao   SincronizacaoIntegracao[]
  errosIntegracao            ErroIntegracao[]
  produtosExternos           ProdutoExterno[]
  estoquesExternos           EstoqueExterno[]
  precosExternos             PrecoExterno[]
  condicoesPagamentoExternas CondicaoPagamentoExterna[]
  importacoesDados           ImportacaoDados[]
  oauthStatesIntegracao      IntegracaoOAuthState[]
  canaisIntegracao           CanalIntegracao[]
  metaCredentials            MetaCredential[]
  enderecosCaixaEmail        EmailMailboxAddress[]
  contatosCanal              ContatoCanal[]
  conversasCanal             ConversaCanal[]
  mensagensCanal             MensagemCanal[]
  metadadosMensagemEmail     EmailMessageMetadata[]
  leads                      Lead[]
  negocios                   Negocio[]
  notasInternasConversa      NotaInternaConversa[]
  historicosAtribuicao       HistoricoAtribuicao[]
  historicosQualificacaoConversa HistoricoQualificacaoConversa[]
  propostasComerciais          PropostaComercial[]
  historicosPropostasComerciais HistoricoPropostaComercial[]
  historicosAcompanhamentos    HistoricoAcompanhamento[]
  automacaoRegras              AutomacaoRegra[]
  automacaoExecucoes           AutomacaoExecucao[]
  automacaoJobs                AutomacaoAcaoJob[]
  automacaoRoundRobin          AutomacaoRoundRobinEstado[]
  automacaoEventosInternos     AutomacaoEventoInterno[]
  eventosWebhook             EventoWebhook[]
  funcionalidades            EmpresaFuncionalidade[]
  auditoriasFuncionalidade   AuditoriaFuncionalidade[]
  auditoriasPlataforma       PlatformTenantAudit[]
  sessoesUsuario             SessaoUsuario[]
  tokensRefreshUsuario       SessaoRefreshToken[]
  tokensRecuperacaoSenha     TokenRecuperacaoSenha[]
  convitesUsuario            ConviteUsuario[]
  auditoriasSeguranca        AuditoriaSeguranca[]
  notificacoes               Notificacao[]
  configuracaoNotificacao    ConfiguracaoNotificacaoEmpresa?
  preferenciasNotificacao    PreferenciaNotificacaoUsuario[]
  fontesEstoque              FonteEstoque[]
  capacidadesFonteEstoque    CapacidadeFonteEstoque[]
  execucoesSincronizacaoEstoque ExecucaoSincronizacaoEstoque[]
  checkpointsSincronizacaoEstoque CheckpointSincronizacaoEstoque[]
  produtosEstoque            ProdutoEstoque[]
  mapeamentosProdutoEstoque  MapeamentoProdutoExterno[]
  locaisEstoque              LocalEstoque[]
  lotesEstoque               LoteEstoque[]
  saldosEstoque              SaldoEstoque[]
  observacoesEstoque         ObservacaoEstoque[]
  problemasQualidadeEstoque  ProblemaQualidadeEstoque[]
  eventosAuditoriaEstoque    EventoAuditoriaEstoque[]
  eventosOutboxEstoque       EventoOutboxEstoque[]
  importacoesEstoque         ImportacaoEstoque[]
  linhasImportacaoEstoque    LinhaImportacaoEstoque[]
  configuracoesRegraEstoque  ConfiguracaoRegraEstoque[]
  overridesEstoque            OverrideEstoque[]
  avaliacoesRegraEstoque      AvaliacaoRegraEstoque[]
  catalogosComerciais         CommercialCatalogProduct[]
  ofertasProduto              ProductOffer[]
  configuracoesAICommerce    AICommerceSettings[]
  execucoesAICommerce         AICommerceRun[]
  turnosAICommerce            AICommerceTurn[]
  ferramentasAICommerce      AICommerceToolInvocation[]
  decisoesAICommerce          AICommerceDecision[]
  rascunhosAICommerce         AICommerceDraft[]
  politicasAICommerce         AICommercePolicyDecision[]
  handoffsAICommerce          AICommerceHandoff[]
  interessesAICommerce        AICommerceProductInterest[]
  oportunidadesAICommerce     AICommerceOpportunityDraft[]
}

model Usuario {
  id                         Int                       @id @default(autoincrement())
  empresaId                  Int
  empresa                    Empresa                   @relation(fields: [empresaId], references: [id])
  nome                       String
  email                      String
  senhaHash                  String
  papel                      PapelUsuario              @default(VENDEDOR)
  ativo                      Boolean                   @default(true)
  ultimoLoginEm              DateTime?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  importacoesCriadas         ImportacaoDados[]
  oauthStatesIntegracao      IntegracaoOAuthState[]
  leadsResponsaveis          Lead[]                    @relation("LeadResponsavel")
  negociosResponsaveis       Negocio[]                 @relation("NegocioResponsavel")
  negociosConvertidos        Negocio[]                 @relation("NegocioConvertidoPor")
  conversasResponsaveis      ConversaCanal[]           @relation("ConversaResponsavel")
  conversasReservadas        ConversaCanal[]           @relation("ConversaRespostaReservadaPor")
  mensagensCanalEnviadas     MensagemCanal[]           @relation("MensagemCanalAutor")
  notasInternasCriadas       NotaInternaConversa[]     @relation("NotaInternaAutor")
  atribuicoesAnteriores      HistoricoAtribuicao[]     @relation("AtribuicaoResponsavelAnterior")
  atribuicoesNovas           HistoricoAtribuicao[]     @relation("AtribuicaoResponsavelNovo")
  atribuicoesAlteradas       HistoricoAtribuicao[]     @relation("AtribuicaoAlteradoPor")
  qualificacoesComerciaisRegistradas HistoricoQualificacaoConversa[] @relation("QualificacaoComercialAutor")
  propostasComerciaisResponsaveis PropostaComercial[] @relation("PropostaComercialResponsavel")
  propostasComerciaisCriadas      PropostaComercial[] @relation("PropostaComercialAutor")
  historicosPropostasComerciais   HistoricoPropostaComercial[] @relation("HistoricoPropostaComercialAutor")
  acompanhamentosResponsaveis     Acompanhamento[] @relation("AcompanhamentoResponsavel")
  acompanhamentosCriados          Acompanhamento[] @relation("AcompanhamentoAutor")
  acompanhamentosConcluidos       Acompanhamento[] @relation("AcompanhamentoConcluidoPor")
  acompanhamentosCancelados       Acompanhamento[] @relation("AcompanhamentoCanceladoPor")
  historicosAcompanhamentos       HistoricoAcompanhamento[] @relation("HistoricoAcompanhamentoAutor")
  historicosAcompanhamentosAnteriores HistoricoAcompanhamento[] @relation("HistoricoAcompanhamentoResponsavelAnterior")
  historicosAcompanhamentosNovos     HistoricoAcompanhamento[] @relation("HistoricoAcompanhamentoResponsavelNovo")
  automacaoRegrasCriadas        AutomacaoRegra[] @relation("AutomacaoRegraCriador")
  automacaoRegrasAtualizadas    AutomacaoRegra[] @relation("AutomacaoRegraAtualizador")
  automacaoEventosInternos      AutomacaoEventoInterno[] @relation("AutomacaoEventoAutor")
  automacaoRoundRobinEstados    AutomacaoRoundRobinEstado[] @relation("AutomacaoRoundRobinResponsavel")
  funcionalidadesHabilitadas EmpresaFuncionalidade[]   @relation("FuncionalidadeHabilitadaPor")
  auditoriasFuncionalidade   AuditoriaFuncionalidade[] @relation("AuditoriaFuncionalidadeUsuario")
  auditoriasPlataforma       PlatformTenantAudit[]      @relation("PlatformTenantAuditActor")
  tenantsCriadosPlataforma   PlatformTenantAudit[]      @relation("PlatformTenantAuditAdmin")
  sessoes                     SessaoUsuario[]
  tokensRecuperacaoSenha      TokenRecuperacaoSenha[]
  convitesCriados             ConviteUsuario[]
  notificacoesRecebidas       Notificacao[] @relation("NotificacaoDestinatario")
  preferenciasNotificacao    PreferenciaNotificacaoUsuario[]
  importacoesEstoqueCriadas  ImportacaoEstoque[] @relation("ImportacaoEstoqueActor")
  eventosAuditoriaEstoque    EventoAuditoriaEstoque[] @relation("EventoAuditoriaEstoqueActor")
  configuracoesAICommerce     AICommerceSettings[] @relation("AICommerceSettingsActor")
  interessesAICommerce        AICommerceProductInterest[] @relation("AICommerceInterestActor")
  oportunidadesAICommerce    AICommerceOpportunityDraft[] @relation("AICommerceDraftActor")
  rascunhosAICommerce         AICommerceDraft[] @relation("AICommerceDraftAuditActor")
  politicasAICommerce         AICommercePolicyDecision[] @relation("AICommercePolicyActor")
  handoffsAICommerce          AICommerceHandoff[] @relation("AICommerceHandoffActor")

  @@unique([empresaId, email])
  @@unique([empresaId, id])
  @@index([empresaId])
  @@index([email])
  @@index([ativo])
}

model SessaoUsuario {
  id                    String                 @id @default(cuid())
  empresaId             Int
  usuarioId             Int
  empresa               Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario               Usuario                @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Cascade, onUpdate: Restrict)
  familyId              String
  userAgentSanitizado   String?
  ipHash                String?
  criadoEm              DateTime               @default(now())
  ultimoUsoEm           DateTime               @default(now())
  expiraEm              DateTime
  revogadoEm            DateTime?
  motivoRevogacao       String?
  tokens                SessaoRefreshToken[]

  @@unique([empresaId, id])
  @@index([empresaId, usuarioId, revogadoEm])
  @@index([empresaId, expiraEm])
  @@index([familyId])
}

model SessaoRefreshToken {
  id          String        @id @default(cuid())
  empresaId   Int
  sessaoId    String
  empresa     Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sessao      SessaoUsuario @relation(fields: [empresaId, sessaoId], references: [empresaId, id], onDelete: Cascade, onUpdate: Restrict)
  tokenHash   String        @unique
  emitidoEm   DateTime      @default(now())
  usadoEm     DateTime?
  revogadoEm  DateTime?
  expiraEm    DateTime

  @@unique([empresaId, id])
  @@index([empresaId, sessaoId])
  @@index([empresaId, expiraEm])
}

model TokenRecuperacaoSenha {
  id          String   @id @default(cuid())
  empresaId   Int
  usuarioId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario     Usuario  @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Cascade, onUpdate: Restrict)
  tokenHash   String   @unique
  expiraEm    DateTime
  usadoEm     DateTime?
  revogadoEm  DateTime?
  criadoEm    DateTime @default(now())

  @@unique([empresaId, id])
  @@index([empresaId, usuarioId, expiraEm])
}

model ConviteUsuario {
  id                 String       @id @default(cuid())
  empresaId          Int
  convidadoPorId     Int
  empresa            Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  convidadoPor       Usuario      @relation(fields: [empresaId, convidadoPorId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  nomeConvidado      String
  emailNormalizado   String
  papel              PapelUsuario @default(VENDEDOR)
  tokenHash          String       @unique
  expiraEm           DateTime
  aceitoEm           DateTime?
  revogadoEm         DateTime?
  deliveryStatus     String       @default("PENDING_DELIVERY")
  criadoEm           DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([empresaId, id])
  @@unique([empresaId, emailNormalizado])
  @@index([empresaId, expiraEm])
  @@index([empresaId, aceitoEm, revogadoEm])
}

model AuditoriaSeguranca {
  id              Int      @id @default(autoincrement())
  empresaId       Int
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  actorUsuarioId  Int?
  targetUsuarioId Int?
  acao            String
  resultado       String
  correlationId   String?
  motivo          String?
  createdAt       DateTime @default(now())

  @@index([empresaId, createdAt])
  @@index([empresaId, actorUsuarioId, createdAt])
  @@index([empresaId, targetUsuarioId, createdAt])
  @@index([empresaId, acao, createdAt])
}

model IntegracaoOAuthState {
  id                  Int               @id @default(autoincrement())
  empresaId           Int
  empresa             Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarioId           Int
  usuario             Usuario           @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Cascade, onUpdate: Restrict)
  canalIntegracaoId   Int?
  canalIntegracao     CanalIntegracao?  @relation(fields: [empresaId, canalIntegracaoId], references: [empresaId, id], onDelete: Cascade, onUpdate: Restrict)
  provedor            String
  fluxo               String?
  stateHash           String            @unique
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime          @default(now())

  @@index([empresaId])
  @@index([usuarioId])
  @@index([empresaId, canalIntegracaoId, fluxo])
  @@index([provedor])
  @@index([expiresAt])
}

model Integracao {
  id                        Int                        @id @default(autoincrement())
  empresaId                 Int
  empresa                   Empresa                    @relation(fields: [empresaId], references: [id])
  nome                      String
  tipo                      TipoIntegracao
  status                    StatusIntegracao           @default(PENDENTE)
  modo                      ModoIntegracao             @default(SOMENTE_LEITURA)
  configuracaoJson          String                     @default("{}")
  credenciaisCriptografadas String?
  ultimaSincronizacaoEm     DateTime?
  ultimoSucessoEm           DateTime?
  ultimoErroEm              DateTime?
  ativo                     Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  sincronizacoes            SincronizacaoIntegracao[]
  erros                     ErroIntegracao[]
  produtosExternos          ProdutoExterno[]
  estoquesExternos          EstoqueExterno[]
  precosExternos            PrecoExterno[]
  condicoesPagamento        CondicaoPagamentoExterna[]
  importacoes               ImportacaoDados[]

  @@unique([empresaId, id])
  @@index([empresaId])
  @@index([empresaId, status])
  @@index([empresaId, tipo])
  @@index([ativo])
}

model MetaCredential {
  id                Int                  @id @default(autoincrement())
  empresaId         Int
  empresa           Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  canalIntegracaoId Int
  canalIntegracao   CanalIntegracao      @relation("MetaCredentialChannel", fields: [empresaId, canalIntegracaoId], references: [empresaId, id], onDelete: Cascade, onUpdate: Restrict)
  currentChannels   CanalIntegracao[]    @relation("MetaCredentialCurrent")
  provider          String
  reference         String               @unique
  ciphertext        String
  status            StatusCredencialMeta @default(ATIVA)
  revision          Int                  @default(1)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  removedAt         DateTime?

  @@unique([empresaId, id])
  @@unique([empresaId, reference])
  @@unique([empresaId, canalIntegracaoId, reference])
  @@unique([empresaId, canalIntegracaoId, provider, reference])
  @@index([empresaId, canalIntegracaoId, provider, status])
  @@index([empresaId, reference])
}

model SincronizacaoIntegracao {
  id               Int                 @id @default(autoincrement())
  integracaoId     Int
  integracao       Integracao          @relation(fields: [empresaId, integracaoId], references: [empresaId, id], onDelete: Cascade, onUpdate: Restrict)
  empresaId        Int
  empresa          Empresa             @relation(fields: [empresaId], references: [id])
  status           StatusSincronizacao @default(PENDENTE)
  origem           OrigemSincronizacao @default(MANUAL)
  iniciadaEm       DateTime            @default(now())
  finalizadaEm     DateTime?
  itensRecebidos   Int                 @default(0)
