  @@unique([empresaId, idempotencyKey])
  @@index([empresaId, status, createdAt])
  @@index([empresaId, entidadeTipo, entidadeId])
  @@index([empresaId, leadId])
  @@index([empresaId, negocioId])
}

model AutomacaoAcaoJob {
