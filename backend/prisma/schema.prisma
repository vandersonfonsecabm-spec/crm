  cursorAntes       String?
  cursorDepois      String?
  snapshotGeneration String?
  lidos             Int             @default(0)
  aceitos           Int             @default(0)
  rejeitados        Int             @default(0)
  criados           Int             @default(0)
  atualizados       Int             @default(0)
  tombstoned        Int             @default(0)
  warningsJson      String?
  errorClass        String?
  retryCount        Int             @default(0)
  correlationId     String?
  leaseOwner        String?
  leaseExpiresAt    DateTime?
  revision          Int             @default(1)
  retentionUntil    DateTime
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  empresa           Empresa         @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fonte             FonteEstoque    @relation(fields: [empresaId, fonteId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict)
  observacoes       ObservacaoEstoque[]
  problemasQualidade ProblemaQualidadeEstoque[]
  importacoes       ImportacaoEstoque[]

  @@unique([empresaId, id])
  @@index([empresaId, fonteId, startedAt])
  @@index([empresaId, estado, leaseExpiresAt])
  @@index([empresaId, retentionUntil])
}

