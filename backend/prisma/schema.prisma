// E2 estoque source-agnostic. Todas as relacoes entre entidades tenant-scoped
// usam [empresaId, id] para impedir vinculos cruzados entre tenants.
model FonteEstoque {
  id                       Int                       @id @default(autoincrement())
  empresaId                Int
  tipoFonte                StockSourceType
  nome                     String
  statusCiclo              StockSourceStatus         @default(DRAFT)
  configuracaoPublicaJson  String?
  credencialRef            String?
  capabilitiesVersion      String?
  prioridade               Int                       @default(100)
  schemaVersion            String
  disabledAt               DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  empresa                  Empresa                   @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  capacidades              CapacidadeFonteEstoque[]
  execucoes                ExecucaoSincronizacaoEstoque[]
  checkpoint               CheckpointSincronizacaoEstoque?
  mapeamentos              MapeamentoProdutoExterno[]
  locais                   LocalEstoque[]
  lotes                    LoteEstoque[]
  saldosAutoritativos      SaldoEstoque[]            @relation("SaldoEstoqueFonteAutoritativa")
  observacoes              ObservacaoEstoque[]
  problemasQualidade       ProblemaQualidadeEstoque[]
  importacoes              ImportacaoEstoque[]
  avaliacoesRegraEstoque   AvaliacaoRegraEstoque[] @relation("AvaliacaoRegraEstoqueFonte")

  @@unique([empresaId, nome])
  @@unique([empresaId, id])
  @@index([empresaId, statusCiclo])
  @@index([empresaId, tipoFonte, statusCiclo])
}

model CapacidadeFonteEstoque {
  id             Int          @id @default(autoincrement())
