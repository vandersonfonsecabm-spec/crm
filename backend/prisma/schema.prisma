  erroCodigo     String?
  erroResumo     String?
  resultadoJson  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([empresaId, actionKey])
  @@index([empresaId, status, nextAttemptAt])
  @@index([empresaId, execucaoId, indice])
  @@index([empresaId, leaseExpiresAt])
}

model AutomacaoRoundRobinEstado {
